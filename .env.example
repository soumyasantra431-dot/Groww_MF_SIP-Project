# Copy this file to .dev.vars locally. Never put real keys in this example.
MODEL_PROVIDER=groq
MODEL_BILLING_MODE=free
GROQ_FREE_PLAN_CONFIRMED=false
MODEL_FREE_DAILY_TOKEN_CAP=180000
MODEL_FREE_MAX_CALLS=10
GROQ_API_KEY=
MODEL_ID=openai/gpt-oss-120b
# Free-only project. Enable a bounded run after input/source checks.
ALLOW_MODEL_CALLS=false
MODEL_SPEND_CAP_USD=0
MODEL_KILL_SWITCH=true
PUBLIC_REQUESTS_PER_HOUR=10
# Free token quota resets at 00:00 UTC (05:30 IST), not a rolling 24 hours.
# Optional YouTube route has separate permission and credentials; leave blank.
YOUTUBE_API_KEY=
# Set only after a valid documented source-specific basis, never as a terms bypass.
REDDIT_RESEARCH_USE_APPROVED=false
YOUTUBE_DERIVED_USE_APPROVED=false
PORT=4317

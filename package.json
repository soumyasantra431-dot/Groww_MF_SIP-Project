{
  "name": "sip-research-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "pipeline": "node --env-file-if-exists=.dev.vars scripts/pipeline.mjs",
    "seed": "node scripts/seed-context.mjs",
    "snapshot": "node scripts/pipeline.mjs snapshot"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "gpt-tokenizer": "4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
